# Copy this file to .env and fill in secrets.
# Never commit the real .env file.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JSON object of quiz answers, e.g. {"Q01":{"correct_answer":"A","explanation":"..."}}
# Required in production / Cursor secrets. Locally you may instead use gitignored
# private/answers.dev.json
QUIZ_ANSWER_BANK=
