# Copy this file to .env and fill in secrets.
# Never commit the real .env file.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# QUIZ_ANSWER_BANK = actual answer JSON (NOT an encryption key).
# Format: {"Q01":{"correct_answer":"A","explanation":"..."}, "Q02":{...}}
# See docs/QUIZ_ANSWER_BANK.md. Locally you may use gitignored private/answers.dev.json
# only when TUTORRAG_ALLOW_DEV_ANSWERS=1.
QUIZ_ANSWER_BANK=
TUTORRAG_ALLOW_DEV_ANSWERS=0

# Shared class unlock code for public deployments (required for public publish).
APP_ACCESS_CODE=

# Optional CAPTCHA signing pepper (auto-generated per process if unset).
CAPTCHA_PEPPER=

# Groq usage budgets (server-side, persistent).
GROQ_DAILY_LIMIT=40
GROQ_MONTHLY_LIMIT=400

