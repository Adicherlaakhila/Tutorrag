# Copy this file to .env and fill in secrets.
# Never commit the real .env file.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# QUIZ_ANSWER_BANK = actual answer JSON (NOT an encryption key).
# Format: {"Q01":{"correct_answer":"A","explanation":"..."}, "Q02":{...}}
# See docs/QUIZ_ANSWER_BANK.md. Locally you may use gitignored private/answers.dev.json.
QUIZ_ANSWER_BANK=
