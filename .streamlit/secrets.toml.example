# Copy values into Streamlit Community Cloud → App settings → Secrets
# (do not commit a real secrets.toml).

GROQ_API_KEY = "your_groq_api_key"
GROQ_MODEL = "llama-3.3-70b-versatile"

# Full JSON answer bank — see docs/QUIZ_ANSWER_BANK.md
QUIZ_ANSWER_BANK = "{\"Q01\":{\"correct_answer\":\"A\",\"explanation\":\"...\"}}"

APP_ACCESS_CODE = "your-class-access-code"
CAPTCHA_PEPPER = "generate-with-secrets-token-hex-32"

GROQ_DAILY_LIMIT = "40"
GROQ_MONTHLY_LIMIT = "400"
